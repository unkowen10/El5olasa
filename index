<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0f0f23">
    <meta name="description" content="اختبارات تفاعلية شاملة في أساسيات البرمجة وهندسة البرمجيات 2026">
    <title>🚀 اختبارات البرمجة الشاملة 2026</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <style>
        /* ═══════════ 1) المتغيرات ونظام الألوان ═══════════ */
        :root {
            --bg1: #0f0f23;
            --bg2: #1a1a3e;
            --p1: #6366f1;
            --p2: #8b5cf6;
            --s1: #06b6d4;
            --s2: #22d3ee;
            --ok: #10b981;
            --err: #ef4444;
            --warn: #f59e0b;
            --t1: #f1f5f9;
            --t2: #94a3b8;
            --glass: rgba(255, 255, 255, .045);
            --glass2: rgba(255, 255, 255, .09);
            --r-sm: 12px;
            --r-md: 16px;
            --r-lg: 24px;
            --tr: .35s cubic-bezier(.4, 0, .2, 1);
            --tr-spring: .5s cubic-bezier(.22, 1, .36, 1);
            --grad-p: linear-gradient(135deg, var(--p1), var(--p2));
            --grad-s: linear-gradient(135deg, var(--s1), var(--s2));
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box
        }

        html {
            scroll-behavior: smooth
        }

        body {
            font-family: 'Cairo', 'Space Grotesk', sans-serif;
            color: var(--t1);
            line-height: 1.75;
            min-height: 100vh;
            overflow-x: hidden;
            background: linear-gradient(160deg, var(--bg1) 0%, var(--bg2) 55%, var(--bg1) 100%) fixed;
        }

        .en {
            font-family: 'Space Grotesk', 'Cairo', sans-serif;
            direction: ltr;
            unicode-bidi: isolate
        }

        ::selection {
            background: rgba(99, 102, 241, .45);
            color: #fff
        }

        :focus-visible {
            outline: 3px solid var(--s2);
            outline-offset: 3px;
            border-radius: 8px
        }

        button {
            font-family: inherit
        }

        /* ═══════════ 2) الخلفية المتحركة (جسيمات + كرات ضبابية) ═══════════ */
        #bgParticles {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none
        }

        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(90px);
            opacity: .45;
            z-index: 0;
            pointer-events: none;
            animation: orbFloat 26s ease-in-out infinite alternate;
            will-change: transform
        }

        .orb1 {
            width: 480px;
            height: 480px;
            background: radial-gradient(circle, rgba(99, 102, 241, .55), transparent 70%);
            top: -120px;
            right: -120px
        }

        .orb2 {
            width: 420px;
            height: 420px;
            background: radial-gradient(circle, rgba(34, 211, 238, .4), transparent 70%);
            bottom: -100px;
            left: -100px;
            animation-delay: -8s
        }

        .orb3 {
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(139, 92, 246, .45), transparent 70%);
            top: 45%;
            left: 55%;
            animation-delay: -15s
        }

        @keyframes orbFloat {
            0% {
                transform: translate(0, 0) scale(1)
            }

            50% {
                transform: translate(-40px, 30px) scale(1.08)
            }

            100% {
                transform: translate(30px, -40px) scale(.95)
            }
        }

        #fxCanvas {
            position: fixed;
            inset: 0;
            z-index: 60;
            pointer-events: none
        }

        /* ═══════════ 3) الشاشات والانتقالات (SPA) ═══════════ */
        .screen {
            display: none;
            position: relative;
            z-index: 2;
            min-height: 100vh
        }

        .screen.active {
            display: block;
            animation: screenIn .55s cubic-bezier(.22, 1, .36, 1)
        }

        @keyframes screenIn {
            from {
                opacity: 0;
                transform: translateY(26px)
            }

            to {
                opacity: 1;
                transform: none
            }
        }

        .wrap {
            max-width: 1200px;
            margin: 0 auto;
            padding: 24px
        }

        /* ═══════════ 4) الزجاج والحدود المتدرجة (Glassmorphism) ═══════════ */
        .glass {
            position: relative;
            background: var(--glass);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: var(--r-lg);
            box-shadow: 0 4px 12px rgba(0, 0, 0, .25)
        }

        .glass::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            padding: 1px;
            background: linear-gradient(135deg, rgba(99, 102, 241, .55), rgba(34, 211, 238, .22) 50%, rgba(139, 92, 246, .45));
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none
        }

        /* ═══════════ 5) شاشة البداية ═══════════ */
        .hero {
            text-align: center;
            padding: 64px 16px 28px
        }

        .rocket {
            font-size: clamp(3rem, 7vw, 5rem);
            display: inline-block;
            animation: rocketFloat 3.5s ease-in-out infinite;
            filter: drop-shadow(0 8px 24px rgba(99, 102, 241, .5))
        }

        @keyframes rocketFloat {

            0%,
            100% {
                transform: translateY(0) rotate(-6deg)
            }

            50% {
                transform: translateY(-14px) rotate(6deg)
            }
        }

        .hero h1 {
            font-size: clamp(1.7rem, 5vw, 3.4rem);
            font-weight: 900;
            letter-spacing: -.5px;
            margin: 10px 0 12px;
            background: linear-gradient(135deg, #f1f5f9, #a5b4fc 45%, #67e8f9);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent
        }

        .hero p {
            color: var(--t2);
            font-size: clamp(1rem, 2vw, 1.25rem);
            font-weight: 300;
            max-width: 640px;
            margin: 0 auto
        }

        .gstats {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
            margin: 28px 0 8px
        }

        .gstat {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            border-radius: 99px;
            background: var(--glass);
            border: 1px solid rgba(255, 255, 255, .1);
            font-weight: 700;
            font-size: .95rem;
            backdrop-filter: blur(12px)
        }

        .gstat b {
            color: #a5b4fc;
            font-family: 'Space Grotesk'
        }

        .resume {
            max-width: 760px;
            margin: 20px auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 18px 24px;
            border: 1px solid rgba(245, 158, 11, .4) !important;
            flex-wrap: wrap
        }

        .resume .hidden {
            display: none
        }

        .resume-info {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 700
        }

        .resume-info small {
            display: block;
            color: var(--t2);
            font-weight: 400
        }

        .quiz-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
            gap: 24px;
            padding: 16px 0 40px
        }

        .quiz-card {
            padding: 26px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            transition: transform .45s var(--tr-spring), box-shadow .45s;
            animation: cardUp .6s var(--tr-spring) both
        }

        .quiz-card:nth-child(2) {
            animation-delay: .06s
        }

        .quiz-card:nth-child(3) {
            animation-delay: .12s
        }

        .quiz-card:nth-child(4) {
            animation-delay: .18s
        }

        .quiz-card:nth-child(5) {
            animation-delay: .24s
        }

        .quiz-card:nth-child(6) {
            animation-delay: .3s
        }

        @keyframes cardUp {
            from {
                opacity: 0;
                transform: translateY(30px)
            }

            to {
                opacity: 1;
                transform: none
            }
        }

        .quiz-card:hover {
            transform: perspective(900px) rotateX(3deg) rotateY(-3deg) translateY(-10px);
            box-shadow: 0 24px 60px rgba(0, 0, 0, .5), 0 0 44px color-mix(in srgb, var(--ac) 32%, transparent)
        }

        .qc-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start
        }

        .qc-icon {
            font-size: 3rem;
            line-height: 1;
            display: inline-block;
            animation: iconFloat 4s ease-in-out infinite;
            filter: drop-shadow(0 0 18px var(--ac));
            transition: transform .4s
        }

        .quiz-card:hover .qc-icon {
            transform: scale(1.18) rotate(-8deg)
        }

        @keyframes iconFloat {

            0%,
            100% {
                transform: translateY(0)
            }

            50% {
                transform: translateY(-8px)
            }
        }

        .qc-level {
            font-size: .8rem;
            font-weight: 800;
            padding: 5px 14px;
            border-radius: 99px
        }

        .lv-b {
            background: rgba(16, 185, 129, .15);
            color: #34d399;
            border: 1px solid rgba(16, 185, 129, .4)
        }

        .lv-m {
            background: rgba(245, 158, 11, .15);
            color: #fbbf24;
            border: 1px solid rgba(245, 158, 11, .4)
        }

        .lv-a {
            background: rgba(244, 63, 94, .15);
            color: #fb7185;
            border: 1px solid rgba(244, 63, 94, .4)
        }

        .qc-title {
            font-size: 1.25rem;
            font-weight: 800;
            line-height: 1.5
        }

        .qc-meta {
            color: var(--t2);
            font-size: .9rem;
            font-weight: 600
        }

        .qc-best {
            font-size: .85rem;
            font-weight: 700;
            color: #34d399;
            background: rgba(16, 185, 129, .1);
            border: 1px dashed rgba(16, 185, 129, .4);
            border-radius: var(--r-sm);
            padding: 8px 14px
        }

        .qc-best.none {
            color: var(--t2);
            border-color: rgba(148, 163, 184, .3)
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px 26px;
            border-radius: 16px;
            border: none;
            cursor: pointer;
            font-weight: 800;
            font-size: 1rem;
            transition: var(--tr);
            text-decoration: none;
            user-select: none
        }

        .btn:active {
            transform: translateY(-1px) scale(.97)
        }

        .btn-primary {
            background: var(--grad-p);
            color: #fff;
            box-shadow: 0 8px 24px rgba(99, 102, 241, .4), inset 0 1px 0 rgba(255, 255, 255, .25)
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 14px 34px rgba(99, 102, 241, .55), 0 0 30px rgba(139, 92, 246, .45)
        }

        .btn-cyan {
            background: var(--grad-s);
            color: #062a33;
            box-shadow: 0 8px 24px rgba(6, 182, 212, .35)
        }

        .btn-cyan:hover {
            transform: translateY(-3px);
            box-shadow: 0 14px 34px rgba(6, 182, 212, .5)
        }

        .btn-ghost {
            background: var(--glass);
            color: var(--t1);
            border: 1px solid rgba(255, 255, 255, .18);
            backdrop-filter: blur(10px)
        }

        .btn-ghost:hover {
            background: var(--glass2);
            transform: translateY(-3px)
        }

        .btn-glow {
            animation: glowPulse 2.4s ease-in-out infinite
        }

        @keyframes glowPulse {

            0%,
            100% {
                box-shadow: 0 8px 24px rgba(99, 102, 241, .35)
            }

            50% {
                box-shadow: 0 8px 36px rgba(139, 92, 246, .6), 0 0 24px rgba(99, 102, 241, .5)
            }
        }

        .btn-start {
            margin-top: auto;
            background: linear-gradient(135deg, var(--ac), color-mix(in srgb, var(--ac) 55%, #8b5cf6));
            color: #fff
        }

        footer {
            text-align: center;
            color: var(--t2);
            font-size: .85rem;
            padding: 24px;
            font-weight: 300
        }

        /* ═══════════ 6) شاشة الاختبار ═══════════ */
        .quiz-topbar {
            position: sticky;
            top: 12px;
            z-index: 20;
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 12px 18px;
            margin-bottom: 22px;
            flex-wrap: wrap
        }

        .icon-btn {
            width: 44px;
            height: 44px;
            min-width: 44px;
            border-radius: 14px;
            border: 1px solid rgba(255, 255, 255, .15);
            background: var(--glass);
            color: var(--t1);
            font-size: 1.2rem;
            cursor: pointer;
            transition: var(--tr);
            display: grid;
            place-items: center
        }

        .icon-btn:hover {
            background: var(--glass2);
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 6px 18px rgba(0, 0, 0, .35)
        }

        .fixed-mute {
            position: fixed;
            bottom: 20px;
            left: 20px;
            z-index: 70;
            backdrop-filter: blur(10px)
        }

        .qt-info {
            min-width: 140px
        }

        .qt-name {
            font-weight: 800;
            font-size: .95rem
        }

        .qt-counter {
            color: var(--t2);
            font-size: .8rem;
            font-weight: 600
        }

        .pbar-wrap {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 180px
        }

        .pbar {
            flex: 1;
            height: 12px;
            border-radius: 99px;
            background: rgba(255, 255, 255, .08);
            overflow: hidden;
            box-shadow: inset 0 2px 6px rgba(0, 0, 0, .35)
        }

        .pfill {
            height: 100%;
            width: 0%;
            border-radius: 99px;
            background: var(--grad-s);
            position: relative;
            transition: width .6s var(--tr-spring);
            box-shadow: 0 0 14px rgba(34, 211, 238, .6)
        }

        .pfill::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .45), transparent);
            animation: shimmer 1.4s linear infinite
        }

        @keyframes shimmer {
            from {
                transform: translateX(-100%)
            }

            to {
                transform: translateX(100%)
            }
        }

        .p-pct {
            font-family: 'Space Grotesk';
            font-weight: 700;
            font-size: .85rem;
            color: #67e8f9;
            min-width: 44px
        }

        .timer {
            position: relative;
            width: 56px;
            height: 56px;
            min-width: 56px
        }

        .timer svg {
            width: 56px;
            height: 56px;
            transform: rotate(-90deg)
        }

        .tbg {
            fill: none;
            stroke: rgba(255, 255, 255, .1);
            stroke-width: 4
        }

        .tfg {
            fill: none;
            stroke: var(--s2);
            stroke-width: 4;
            stroke-linecap: round;
            stroke-dasharray: 125.66;
            stroke-dashoffset: 0;
            transition: stroke-dashoffset 1s linear, stroke .3s;
            filter: drop-shadow(0 0 5px rgba(34, 211, 238, .6))
        }

        .timer .tnum {
            position: absolute;
            inset: 0;
            display: grid;
            place-items: center;
            font-family: 'Space Grotesk';
            font-weight: 700;
            font-size: 15px;
            transition: color .3s
        }

        .timer.danger .tfg {
            stroke: var(--err);
            filter: drop-shadow(0 0 6px rgba(239, 68, 68, .8))
        }

        .timer.danger .tnum {
            color: var(--err);
            animation: pulse 1s infinite
        }

        @keyframes pulse {
            50% {
                transform: scale(1.2)
            }
        }

        .quiz-area {
            padding-bottom: 60px
        }

        .qcard {
            padding: 32px;
            animation: qIn .5s var(--tr-spring)
        }

        .qcard.re-anim {
            animation: qIn .5s var(--tr-spring)
        }

        @keyframes qIn {
            from {
                opacity: 0;
                transform: translateX(-40px)
            }

            to {
                opacity: 1;
                transform: none
            }
        }

        .qcard.shake {
            animation: qShake .5s
        }

        @keyframes qShake {

            0%,
            100% {
                transform: translateX(0)
            }

            20% {
                transform: translateX(-10px)
            }

            40% {
                transform: translateX(10px)
            }

            60% {
                transform: translateX(-6px)
            }

            80% {
                transform: translateX(6px)
            }
        }

        .q-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
            gap: 12px
        }

        .q-num {
            font-family: 'Space Grotesk';
            font-size: 2.6rem;
            font-weight: 700;
            background: var(--grad-p);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            filter: drop-shadow(0 0 18px rgba(99, 102, 241, .5))
        }

        .q-hint {
            color: var(--t2);
            font-size: .78rem;
            font-weight: 600;
            background: var(--glass);
            border: 1px solid rgba(255, 255, 255, .1);
            padding: 6px 14px;
            border-radius: 99px
        }

        .q-text {
            font-size: clamp(1.15rem, 2.6vw, 1.6rem);
            font-weight: 600;
            text-align: left;
            line-height: 1.6;
            margin-bottom: 26px;
            color: var(--t1)
        }

        .options {
            display: grid;
            gap: 14px;
            direction: ltr
        }

        .options.locked .option {
            pointer-events: none
        }

        .option {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 15px 18px;
            border-radius: var(--r-md);
            background: var(--glass);
            border: 1px solid rgba(255, 255, 255, .09);
            cursor: pointer;
            transition: var(--tr);
            text-align: left;
            width: 100%;
            color: var(--t1);
            font-size: 1.02rem;
            position: relative
        }

        .option:hover {
            transform: translateY(-4px) scale(1.01);
            border-color: rgba(99, 102, 241, .6);
            box-shadow: 0 10px 30px rgba(99, 102, 241, .25);
            background: var(--glass2)
        }

        .option .letter {
            width: 40px;
            height: 40px;
            min-width: 40px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            font-weight: 700;
            font-family: 'Space Grotesk';
            background: rgba(99, 102, 241, .18);
            color: #a5b4fc;
            border: 1px solid rgba(99, 102, 241, .35);
            transition: var(--tr)
        }

        .option .otext {
            flex: 1
        }

        .option .mark {
            font-size: 1.25rem;
            font-weight: 900;
            min-width: 26px;
            text-align: center
        }

        .option.correct {
            background: rgba(16, 185, 129, .14);
            border-color: var(--ok);
            box-shadow: 0 0 26px rgba(16, 185, 129, .35);
            animation: pop .45s
        }

        .option.correct .letter {
            background: var(--ok);
            color: #fff;
            border-color: var(--ok)
        }

        .option.correct .mark {
            color: #34d399
        }

        .option.wrong {
            background: rgba(239, 68, 68, .13);
            border-color: var(--err);
            box-shadow: 0 0 22px rgba(239, 68, 68, .3);
            animation: shake .5s
        }

        .option.wrong .letter {
            background: var(--err);
            color: #fff;
            border-color: var(--err)
        }

        .option.wrong .mark {
            color: #fb7185
        }

        .option.dim {
            opacity: .45;
            filter: saturate(.4)
        }

        @keyframes pop {
            0% {
                transform: scale(1)
            }

            45% {
                transform: scale(1.035)
            }

            100% {
                transform: scale(1)
            }
        }

        @keyframes shake {

            0%,
            100% {
                transform: translateX(0)
            }

            20% {
                transform: translateX(-8px)
            }

            40% {
                transform: translateX(8px)
            }

            60% {
                transform: translateX(-5px)
            }

            80% {
                transform: translateX(5px)
            }
        }

        /* ═══════════ 7) لوحة التفسير ═══════════ */
        .feedback {
            margin-top: 22px;
            padding: 0 28px;
            max-height: 0;
            opacity: 0;
            overflow: hidden;
            transform: translateY(26px);
            transition: max-height .65s var(--tr-spring), opacity .45s, transform .5s var(--tr-spring), padding .4s
        }

        .feedback.show {
            max-height: 2400px;
            opacity: 1;
            transform: none;
            padding: 28px
        }

        .timeup-note {
            display: none;
            background: rgba(245, 158, 11, .14);
            border: 1px solid rgba(245, 158, 11, .45);
            color: #fbbf24;
            font-weight: 800;
            border-radius: var(--r-sm);
            padding: 10px 16px;
            margin-bottom: 16px
        }

        .timeup-note.on {
            display: block;
            animation: pop .4s
        }

        .fb-row {
            display: flex;
            gap: 12px;
            align-items: flex-start;
            padding: 12px 0;
            border-bottom: 1px dashed rgba(255, 255, 255, .08);
            font-size: .98rem
        }

        .fb-row:last-of-type {
            border-bottom: none
        }

        .fb-ic {
            font-size: 1.3rem;
            line-height: 1.4
        }

        .fb-row b {
            color: #a5b4fc
        }

        .ok-row {
            color: #34d399
        }

        .ok-row b {
            color: #34d399
        }

        .fb-whys {
            background: rgba(239, 68, 68, .06);
