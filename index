        .results-wrap {
            padding: 48px 24px 70px;
            max-width: 900px
        }

        .res-hero {
            text-align: center;
            padding: 40px 24px;
            animation: cardUp .6s var(--tr-spring)
        }

        .res-msg {
            font-size: clamp(1.4rem, 4vw, 2.2rem);
            font-weight: 900;
            margin-bottom: 20px
        }

        .score-ring {
            position: relative;
            width: 220px;
            height: 220px;
            margin: 0 auto 14px
        }

        .score-ring svg {
            transform: rotate(-90deg);
            width: 220px;
            height: 220px
        }

        .rbg {
            fill: none;
            stroke: rgba(255, 255, 255, .08);
            stroke-width: 12
        }

        .rfg {
            fill: none;
            stroke: url(#rg);
            stroke-width: 12;
            stroke-linecap: round;
            stroke-dasharray: 527.8;
            stroke-dashoffset: 527.8;
            transition: stroke-dashoffset 1.8s cubic-bezier(.22, 1, .36, 1);
            filter: drop-shadow(0 0 12px rgba(99, 102, 241, .6))
        }

        .score-val {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center
        }

        .score-val span {
            font-family: 'Space Grotesk';
            font-size: 3rem;
            font-weight: 700;
            background: var(--grad-s);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent
        }

        .score-val small {
            color: var(--t2);
            font-weight: 700
        }

        .res-quiz-name {
            color: var(--t2);
            font-weight: 700
        }

        .res-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 16px;
            margin: 24px 0
        }

        .rstat {
            padding: 20px;
            text-align: center;
            animation: cardUp .6s var(--tr-spring) both
        }

        .rstat:nth-child(2) {
            animation-delay: .08s
        }

        .rstat:nth-child(3) {
            animation-delay: .16s
        }

        .rstat:nth-child(4) {
            animation-delay: .24s
        }

        .rstat .rv {
            font-family: 'Space Grotesk';
            font-size: 2rem;
            font-weight: 700
        }

        .rstat .rl {
            color: var(--t2);
            font-size: .85rem;
            font-weight: 700
        }

        .rv.ok {
            color: var(--ok);
            text-shadow: 0 0 18px rgba(16, 185, 129, .5)
        }

        .rv.err {
            color: var(--err);
            text-shadow: 0 0 18px rgba(239, 68, 68, .5)
        }

        .rv.neu {
            color: #a5b4fc
        }

        .res-review {
            padding: 26px;
            animation: cardUp .6s var(--tr-spring) .3s both
        }

        .res-review h3 {
            margin-bottom: 16px;
            font-size: 1.15rem
        }

        .review-item {
            background: var(--glass);
            border: 1px solid rgba(255, 255, 255, .09);
            border-radius: var(--r-md);
            padding: 16px 18px;
            margin-bottom: 12px
        }

        .review-item .rq {
            font-size: .95rem;
            margin-bottom: 10px;
            text-align: left
        }

        .review-item .ra {
            font-size: .88rem;
            display: grid;
            gap: 5px
        }

        .tag-err {
            color: #fb7185;
            font-weight: 700
        }

        .tag-ok {
            color: #34d399;
            font-weight: 700
        }

        .rr {
            color: var(--t2);
            font-size: .85rem;
            margin-top: 8px;
            border-top: 1px dashed rgba(255, 255, 255, .1);
            padding-top: 8px
        }

        .no-errors {
            text-align: center;
            color: #34d399;
            font-weight: 800;
            font-size: 1.1rem;
            padding: 20px
        }

        .res-actions {
            display: flex;
            justify-content: center;
            gap: 14px;
            flex-wrap: wrap;
            margin-top: 28px
        }

        /* ═══════════ 9) النوافذ المنبثقة ═══════════ */
        .modal {
            position: fixed;
            inset: 0;
            background: rgba(5, 5, 20, .72);
            backdrop-filter: blur(8px);
            z-index: 100;
            display: none;
            place-items: center;
            padding: 20px
        }

        .modal.open {
            display: grid;
            animation: fadeIn .3s
        }

        @keyframes fadeIn {
            from {
                opacity: 0
            }

            to {
                opacity: 1
            }
        }

        .modal-box {
            max-width: 430px;
            width: 100%;
            padding: 34px;
            text-align: center;
            animation: cardUp .4s var(--tr-spring)
        }

        .modal-ic {
            font-size: 3rem;
            margin-bottom: 10px
        }

        .modal-box h3 {
            font-size: 1.3rem;
            margin-bottom: 8px
        }

        .modal-box p {
            color: var(--t2);
            font-size: .95rem;
            margin-bottom: 22px
        }

        .modal-actions {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap
        }

        /* ═══════════ 10) الاستجابة لجميع الشاشات ═══════════ */
        @media(max-width:820px) {
            .quiz-topbar {
                gap: 10px;
                padding: 10px 14px
            }

            .qt-info {
                order: 1;
                flex: 1
            }

            .timer {
                order: 2
            }

            .pbar-wrap {
                order: 3;
                flex-basis: 100%
            }

            .qcard {
                padding: 22px 18px
            }

            .q-hint {
                display: none
            }

            .feedback {
                padding: 0 18px
            }

            .feedback.show {
                padding: 20px 18px
            }
        }

        @media(max-width:480px) {
            .wrap {
                padding: 14px
            }

            .hero {
                padding: 44px 12px 20px
            }

            .btn {
                padding: 11px 20px;
                font-size: .92rem
            }

            .q-num {
                font-size: 2rem
            }

            .score-ring,
            .score-ring svg {
                width: 180px;
                height: 180px
            }
        }

        @media(min-width:1800px) {
            .wrap {
                max-width: 1500px
            }
        }

        @media(prefers-reduced-motion:reduce) {

            *,
            *::before,
            *::after {
                animation-duration: .01ms !important;
                transition-duration: .01ms !important
            }
        }
    </style>
</head>

