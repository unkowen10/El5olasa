        /* ═══════════════════════════════════════════════════════════
           الحالة العامة والإعدادات
           ═══════════════════════════════════════════════════════════ */
        const $ = s => document.querySelector(s);
        const QTIME = 30; // ثانية لكل سؤال
        const LS = { best: 'qz2026_best', prog: 'qz2026_prog', muted: 'qz2026_muted', hist: 'qz2026_hist' };
        const state = { quiz: null, i: 0, score: 0, answers: [], answered: false, timer: null, left: QTIME, start: 0, muted: localStorage.getItem(LS.muted) === '1' };
        const LETTERS = ['A', 'B', 'C', 'D'];

        /* ═══════ إدارة الشاشات (SPA) ═══════ */
        function showScreen(id) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            $('#screen-' + id).classList.add('active');
