        /* ═══════════════════════════════════════════════════════════
           التخزين المحلي: أفضل النتائج + التقدم + السجل
           ═══════════════════════════════════════════════════════════ */
        const getJSON = (k, d) => { try { return JSON.parse(localStorage.getItem(k)) || d } catch (e) { return d } };
        const setJSON = (k, v) => localStorage.setItem(k, JSON.stringify(v));
        const getBests = () => getJSON(LS.best, {});
        const getProg = () => getJSON(LS.prog, null);
        const getHist = () => getJSON(LS.hist, []);
        function saveProgress() { setJSON(LS.prog, { quizId: state.quiz.id, i: state.i, score: state.score, answers: state.answers }) }
        function clearProgress() { localStorage.removeItem(LS.prog) }
        function saveResult(pct) {
            const bests = getBests(), id = state.quiz.id;
            if (!bests[id] || pct > bests[id].pct) { bests[id] = { pct, score: state.score, total: state.quiz.questions.length, date: Date.now() }; setJSON(LS.best, bests) }
            const hist = getHist(); hist.unshift({ id, pct, date: Date.now() }); setJSON(LS.hist, hist.slice(0, 60));
        }

        /* ═══════════════════════════════════════════════════════════
           شاشة البداية: بناء البطاقات والإحصائيات
           ═══════════════════════════════════════════════════════════ */
        function renderWelcome() {
            const bests = getBests(), hist = getHist(), prog = getProg();
            // الإحصائيات العامة
            const totalQ = QUIZZES.reduce((a, q) => a + q.questions.length, 0);
            $('#gStats').innerHTML = `
    <span class="gstat">📝 <b>${totalQ}</b> سؤال</span>
    <span class="gstat">🗂️ <b>${QUIZZES.length}</b> أقسام</span>
    <span class="gstat">🎯 محاولاتك: <b>${hist.length}</b></span>
    <span class="gstat">💾 محفوظ محلياً</span>`;
            // لافتة استئناف التقدم
            const rb = $('#resumeBanner');
            if (prog) {
                const qz = QUIZZES.find(q => q.id === prog.quizId);
                if (qz) {
                    rb.classList.remove('hidden');
                    rb.innerHTML = `<div class="resume-info"><span style="font-size:1.8rem">${qz.icon}</span><span>لديك اختبار غير مكتمل: ${qz.title}<small>وصلت للسؤال ${prog.i + 1} من ${qz.questions.length} — نقاطك: ${prog.score}</small></span></div><button class="btn btn-cyan" id="btnResume">▶ متابعة الاختبار</button>`;
                    $('#btnResume').onclick = () => startQuiz(qz.id, true);
                }
            } else rb.classList.add('hidden');
            // بطاقات الاختبارات
            $('#quizGrid').innerHTML = QUIZZES.map(qz => {
                const b = bests[qz.id];
                return `<article class="quiz-card glass" style="--ac:${qz.ac}">
      <div class="qc-top"><span class="qc-icon">${qz.icon}</span><span class="qc-level ${qz.lv}">${qz.level}</span></div>
      <h3 class="qc-title">${qz.title}</h3>
      <p class="qc-meta">📝 ${qz.questions.length} سؤالاً · ⏱ ~${qz.mins} دقيقة</p>
      <div class="qc-best ${b ? '' : 'none'}">${b ? '🏅 أفضل نتيجة: ' + b.pct + '%' : '💠 لم تخض هذا الاختبار بعد'}</div>
      <button class="btn btn-start" data-quiz="${qz.id}">${prog && prog.quizId === qz.id ? '▶ متابعة الاختبار' : '🚀 ابدأ الاختبار'}</button>
    </article>`;
            }).join('');
            document.querySelectorAll('[data-quiz]').forEach(b => b.onclick = () => startQuiz(b.dataset.quiz, false));
        }

        /* ═══════════════════════════════════════════════════════════
           محرك الاختبار
           ═══════════════════════════════════════════════════════════ */
        function startQuiz(id, resume = false) {
            state.quiz = QUIZZES.find(q => q.id === id);
            state.answered = false; clearInterval(state.timer);
            const prog = resume ? getProg() : null;
            if (resume && prog && prog.quizId === id) {
                state.i = prog.i; state.score = prog.score; state.answers = prog.answers || [];
            } else {
                state.i = 0; state.score = 0; state.answers = []; saveProgress();
            }
            state.start = Date.now();
            showScreen('quiz');
            renderQuestion();
        }

        function renderQuestion() {
            const qz = state.quiz, q = qz.questions[state.i], total = qz.questions.length;
            state.answered = false; clearInterval(state.timer);
            hideFeedback();
            // الشريط العلوي
            $('#qtName').textContent = qz.icon + ' ' + qz.title;
            $('#qtCounter').textContent = `السؤال ${state.i + 1} من ${total}`;
            const pct = Math.round(state.answers.length / total * 100);
            $('#pFill').style.width = pct + '%'; $('#pPct').textContent = pct + '%';
            // البطاقة مع إعادة الأنيميشن
            const card = $('#qCard'); card.classList.remove('re-anim'); void card.offsetWidth; card.classList.add('re-anim');
            $('#qNum').textContent = String(state.i + 1).padStart(2, '0');
            $('#qText').textContent = q.q;
            // الخيارات
            $('#options').classList.remove('locked');
            $('#options').innerHTML = q.opts.map((o, idx) => `
    <button class="option" data-i="${idx}" aria-label="الخيار ${LETTERS[idx]}">
      <span class="letter">${LETTERS[idx]}</span><span class="otext">${o}</span><span class="mark"></span>
    </button>`).join('');
            document.querySelectorAll('.option').forEach(b => b.onclick = () => pick(+b.dataset.i));
            window.scrollTo({ top: 0, behavior: 'smooth' });
            startTimer();
        }

        function pick(idx) {
            if (state.answered) return;
            state.answered = true;
            clearInterval(state.timer);
            $('#options').classList.add('locked');
            const q = state.quiz.questions[state.i];
            const correct = idx === q.c;
            if (correct) state.score++;
            state.answers.push({ p: idx, ok: correct });
            // تلوين الخيارات
            const opts = document.querySelectorAll('.option');
            opts.forEach((el, i) => {
                const mk = el.querySelector('.mark');
                if (i === q.c) { el.classList.add('correct'); mk.textContent = '✓' }
                else if (i === idx) { el.classList.add('wrong'); mk.textContent = '✗' }
                else el.classList.add('dim');
            });
            // تأثيرات + صوت
            if (correct) {
                sOK();
                const r = opts[idx].getBoundingClientRect();
                confettiBurst(r.left + r.width / 2, r.top + r.height / 2, 50);
            } else {
                sERR();
                $('#qCard').classList.add('shake');
                setTimeout(() => $('#qCard').classList.remove('shake'), 600);
            }
            updateProgress();
            saveProgress();
            showFeedback(correct, false, idx);
        }

        function onTimeout() {
            if (state.answered) return;
            state.answered = true;
            $('#options').classList.add('locked');
            const q = state.quiz.questions[state.i];
            state.answers.push({ p: null, ok: false, to: true });
            document.querySelectorAll('.option').forEach((el, i) => {
                if (i === q.c) { el.classList.add('correct'); el.querySelector('.mark').textContent = '✓' }
                else el.classList.add('dim');
            });
            sERR();
            updateProgress();
            saveProgress();
            showFeedback(false, true, null);
        }

        function updateProgress() {
            const total = state.quiz.questions.length, pct = Math.round(state.answers.length / total * 100);
            $('#pFill').style.width = pct + '%'; $('#pPct').textContent = pct + '%';
        }

        function showFeedback(correct, timedOut, picked) {
            const q = state.quiz.questions[state.i], last = state.i === state.quiz.questions.length - 1;
            $('#fbTimeup').classList.toggle('on', timedOut);
            $('#fbCorrect').textContent = LETTERS[q.c] + '. ' + q.opts[q.c];
            // تأثير الكتابة المتحركة لسبب الاختيار
            typeText($('#fbReason'), q.reason, 10);
            $('#fbExp').textContent = q.exp;
            // أسباب خطأ الخيارات الأخرى
            let wi = 0;
            $('#fbWhys').innerHTML = q.opts.map((o, idx) => {
                if (idx === q.c) return '';
                const line = `<li><span class="w-letter">${LETTERS[idx]}.</span><span><span class="en">${o}</span> — ${q.why[wi]}</span></li>`;
                wi++; return line;
            }).join('');
            $('#btnNext').textContent = last ? '🏆 عرض النتيجة →' : 'السؤال التالي →';
            $('#feedback').classList.add('show');
            setTimeout(() => { $('#feedback').scrollIntoView({ behavior: 'smooth', block: 'nearest' }); $('#btnNext').focus({ preventScroll: true }) }, 350);
        }

        function hideFeedback() { $('#feedback').classList.remove('show'); $('#fbTimeup').classList.remove('on') }

        function nextQuestion() {
            if (!state.answered) return;
            hideFeedback();
            state.i++;
            if (state.i >= state.quiz.questions.length) finishQuiz();
            else { renderQuestion(); window.scrollTo({ top: 0, behavior: 'smooth' }) }
        }

        /* ═══════════════════════════════════════════════════════════
           المؤقت الزمني (دائري SVG)
           ═══════════════════════════════════════════════════════════ */
        const CIRC = 2 * Math.PI * 20; // محيط دائرة المؤقت
        function startTimer() {
            state.left = QTIME;
            const fg = $('#tFg'); fg.style.strokeDasharray = CIRC; fg.style.strokeDashoffset = 0;
            $('#tNum').textContent = QTIME; $('#timerBox').classList.remove('danger');
            clearInterval(state.timer);
            state.timer = setInterval(() => {
                state.left--;
                $('#tNum').textContent = Math.max(state.left, 0);
                fg.style.strokeDashoffset = CIRC * (1 - state.left / QTIME);
                if (state.left <= 10) $('#timerBox').classList.add('danger');
                if (state.left <= 0) { clearInterval(state.timer); onTimeout() }
            }, 1000);
        }

        /* ═══════════════════════════════════════════════════════════
           شاشة النتائج
           ═══════════════════════════════════════════════════════════ */
        function finishQuiz() {
            clearInterval(state.timer);
            const total = state.quiz.questions.length, pct = Math.round(state.score / total * 100);
            const elapsed = Math.round((Date.now() - state.start) / 1000);
            saveResult(pct); clearProgress();
            // الرسالة التقييمية
            const msg = pct >= 90 ? '🏆 ممتاز! أنت محترف!' : pct >= 75 ? '🌟 جيد جداً! أداء رائع!' : pct >= 60 ? '👍 جيد! واصل التعلم!' : '📚 تحتاج مزيداً من المراجعة';
            $('#resMsg').textContent = msg;
            $('#resQuizName').textContent = `اختبار: ${state.quiz.title}`;
            // الإحصائيات
            const wrong = total - state.score;
            $('#resStats').innerHTML = `
    <div class="rstat glass"><div class="rv ok">✓ ${state.score}</div><div class="rl">إجابات صحيحة</div></div>
    <div class="rstat glass"><div class="rv err">✗ ${wrong}</div><div class="rl">إجابات خاطئة</div></div>
    <div class="rstat glass"><div class="rv neu">${pct}%</div><div class="rl">النسبة المئوية</div></div>
    <div class="rstat glass"><div class="rv neu">⏱ ${fmtTime(elapsed)}</div><div class="rl">الوقت المستغرق</div></div>`;
            // مراجعة الأخطاء
            const wrongs = state.answers.map((a, i) => ({ a, q: state.quiz.questions[i], i })).filter(x => !x.a.ok);
            $('#reviewList').innerHTML = wrongs.length ? wrongs.map(({ a, q, i }) => `
    <div class="review-item">
      <div class="q-head" style="margin-bottom:8px"><b>السؤال ${i + 1}</b></div>
      <div class="rq en">${q.q}</div>
      <div class="ra">
        <span class="tag-err">✗ إجابتك: ${a.p === null ? 'لم تجب — انتهى الوقت' : LETTERS[a.p] + '. ' + q.opts[a.p]}</span>
        <span class="tag-ok">✓ الصحيحة: ${LETTERS[q.c]}. ${q.opts[q.c]}</span>
      </div>
      <div class="rr">📌 ${q.reason}</div>
    </div>`).join('')
                : '<div class="no-errors">🎉 ممتاز! لم ترتكب أي خطأ في هذا الاختبار!</div>';
            showScreen('results');
            // الدائرة المتحركة + العد التصاعدي
            const rFg = $('#rFg'); rFg.style.strokeDashoffset = 527.8;
            setTimeout(() => { rFg.style.strokeDashoffset = 527.8 * (1 - pct / 100) }, 100);
            countUp($('#rPct'), pct, 1600);
            // احتفال كبير
            setTimeout(() => { confettiRain(pct >= 60 ? 220 : 90); if (pct >= 75) setTimeout(() => confettiRain(160), 700); sWin() }, 400);
        }

        function countUp(el, target, dur) {
            const t0 = performance.now();
            (function step(t) {
                const p = Math.min((t - t0) / dur, 1), e = 1 - Math.pow(1 - p, 3);
                el.textContent = Math.round(target * e) + '%';
                if (p < 1) requestAnimationFrame(step);
            })(t0);
        }
        const fmtTime = s => `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;

        /* ═══════════════════════════════════════════════════════════
           الكونفيتي (Canvas مخصص بدون مكتبات)
           ═══════════════════════════════════════════════════════════ */
        const FX = { cv: $('#fxCanvas'), parts: [], raf: null };
        FX.ctx = FX.cv.getContext('2d');
        function fxResize() { FX.cv.width = innerWidth; FX.cv.height = innerHeight }
        fxResize(); addEventListener('resize', fxResize);
        const FX_COLORS = ['#6366f1', '#8b5cf6', '#06b6d4', '#22d3ee', '#10b981', '#f59e0b', '#f43f5e', '#f1f5f9'];
        function fxPush(x, y, vx, vy) { FX.parts.push({ x, y, vx, vy, rot: Math.random() * 6.3, vr: (Math.random() - .5) * .3, w: 6 + Math.random() * 7, h: 4 + Math.random() * 5, c: FX_COLORS[Math.random() * FX_COLORS.length | 0], life: 90 + Math.random() * 70, shape: Math.random() < .5 ? 0 : 1 }) }
        function confettiBurst(x, y, n = 50) { for (let i = 0; i < n; i++) { const a = Math.random() * 6.3, sp = 3 + Math.random() * 7; fxPush(x, y, Math.cos(a) * sp, Math.sin(a) * sp - 3) } fxLoop() }
        function confettiRain(n = 150) { for (let i = 0; i < n; i++)fxPush(Math.random() * FX.cv.width, -20 - Math.random() * 200, (Math.random() - .5) * 2, 2 + Math.random() * 4); fxLoop() }
        function fxLoop() {
            if (FX.raf) return;
            (function draw() {
                const c = FX.ctx; c.clearRect(0, 0, FX.cv.width, FX.cv.height);
                FX.parts = FX.parts.filter(p => p.life > 0 && p.y < FX.cv.height + 30);
                for (const p of FX.parts) {
                    p.x += p.vx; p.y += p.vy; p.vy += .12; p.vx *= .99; p.rot += p.vr; p.life--;
                    c.save(); c.translate(p.x, p.y); c.rotate(p.rot); c.globalAlpha = Math.min(p.life / 40, 1); c.fillStyle = p.c;
                    if (p.shape) c.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
                    else { c.beginPath(); c.arc(0, 0, p.w / 2.4, 0, 6.3); c.fill() }
                    c.restore();
                }
                if (FX.parts.length) FX.raf = requestAnimationFrame(draw);
                else { FX.raf = null; c.clearRect(0, 0, FX.cv.width, FX.cv.height) }
            })();
        }

        /* ═══════════════════════════════════════════════════════════
           جسيمات الخلفية المتصلة
           ═══════════════════════════════════════════════════════════ */
        (function () {
            const cv = $('#bgParticles'), ctx = cv.getContext('2d');
            let W, H, pts = [];
            function resize() { W = cv.width = innerWidth; H = cv.height = innerHeight; const n = Math.min(90, Math.floor(W * H / 24000)); pts = Array.from({ length: n }, () => ({ x: Math.random() * W, y: Math.random() * H, vx: (Math.random() - .5) * .4, vy: (Math.random() - .5) * .4, r: 1 + Math.random() * 2 })) }
            resize(); addEventListener('resize', resize);
            (function loop() {
                if (!document.hidden) {
                    ctx.clearRect(0, 0, W, H);
                    for (const p of pts) {
                        p.x += p.vx; p.y += p.vy;
                        if (p.x < 0 || p.x > W) p.vx *= -1; if (p.y < 0 || p.y > H) p.vy *= -1;
                        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, 6.3); ctx.fillStyle = 'rgba(139,142,246,.5)'; ctx.fill();
                    }
                    for (let i = 0; i < pts.length; i++)for (let j = i + 1; j < pts.length; j++) {
                        const dx = pts[i].x - pts[j].x, dy = pts[i].y - pts[j].y, d = dx * dx + dy * dy;
                        if (d < 12100) { ctx.strokeStyle = `rgba(99,102,241,${.14 * (1 - d / 12100)})`; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(pts[i].x, pts[i].y); ctx.lineTo(pts[j].x, pts[j].y); ctx.stroke() }
                    }
                }
                requestAnimationFrame(loop);
            })();
            // تأثير Parallax للكرات الضبابية مع حركة الماوس
            if (matchMedia('(hover:hover)').matches) addEventListener('mousemove', e => {
                const nx = e.clientX / innerWidth - .5, ny = e.clientY / innerHeight - .5;
                document.querySelectorAll('.orb').forEach((o, i) => { const d = (i + 1) * 18; o.style.translate = `${nx * d}px ${ny * d}px` });
            });
        })();

        /* ═══════════════════════════════════════════════════════════
           الأصوات (Web Audio API — بدون ملفات خارجية)
           ═══════════════════════════════════════════════════════════ */
        let AC = null;
        const ac = () => { if (!AC) AC = new (window.AudioContext || window.webkitAudioContext)(); if (AC.state === 'suspended') AC.resume(); return AC };
        function tone(f, t0, dur, type = 'sine', vol = .14) {
            try {
                const a = ac(), o = a.createOscillator(), g = a.createGain();
                o.type = type; o.frequency.value = f;
                g.gain.setValueAtTime(vol, a.currentTime + t0);
                g.gain.exponentialRampToValueAtTime(.001, a.currentTime + t0 + dur);
                o.connect(g).connect(a.destination); o.start(a.currentTime + t0); o.stop(a.currentTime + t0 + dur);
            } catch (e) { }
        }
        const sOK = () => { if (!state.muted) [523.25, 659.25, 783.99].forEach((f, i) => tone(f, i * .09, .2, 'sine', .13)) };
        const sERR = () => { if (!state.muted) { tone(196, 0, .22, 'sawtooth', .07); tone(147, .13, .28, 'sawtooth', .07) } };
        const sWin = () => { if (!state.muted) [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => tone(f, i * .14, .3, 'triangle', .12)) };
        function renderMute() { $('#btnMute').textContent = state.muted ? '🔇' : '🔊' }
        $('#btnMute').onclick = () => { state.muted = !state.muted; localStorage.setItem(LS.muted, state.muted ? '1' : '0'); renderMute() };
        renderMute();

        /* ═══════════════════════════════════════════════════════════
           تأثير الكتابة المتحركة
           ═══════════════════════════════════════════════════════════ */
        function typeText(el, text, speed = 10) {
            clearInterval(el._t); el.textContent = ''; let i = 0;
            el._t = setInterval(() => { el.textContent += text[i++]; if (i >= text.length) clearInterval(el._t) }, speed);
        }

        /* ═══════════════════════════════════════════════════════════
           التنقل والأحداث العامة + دعم لوحة المفاتيح
           ═══════════════════════════════════════════════════════════ */
        $('#btnNext').onclick = nextQuestion;
        $('#btnExit').onclick = () => $('#exitModal').classList.add('open');
        $('#mCancel').onclick = () => $('#exitModal').classList.remove('open');
        $('#mConfirm').onclick = () => { $('#exitModal').classList.remove('open'); clearInterval(state.timer); saveProgress(); goHome() };
        $('#btnHome').onclick = goHome;
        $('#btnOther').onclick = goHome;
        $('#btnRetry').onclick = () => startQuiz(state.quiz.id, false);
        function goHome() { clearInterval(state.timer); renderWelcome(); showScreen('welcome') }
        // إغلاق النافذة بالنقر خارجها
        $('#exitModal').addEventListener('click', e => { if (e.target.id === 'exitModal') $('#exitModal').classList.remove('open') });
        // لوحة المفاتيح: 1-4 / A-D للإجابة، Enter للتالي
        document.addEventListener('keydown', e => {
            if (!$('#screen-quiz').classList.contains('active')) return;
            if (e.key === 'Escape') { $('#exitModal').classList.add('open'); return }
            if (e.key === 'Enter') {
                if (e.target.tagName === 'BUTTON') return; // ترك للأزرار الأصلية
                if (state.answered) nextQuestion();
                return;
            }
            if (state.answered) return;
            const map = { '1': 0, '2': 1, '3': 2, '4': 3, 'a': 0, 'b': 1, 'c': 2, 'd': 3, 'A': 0, 'B': 1, 'C': 2, 'D': 3 };
            if (e.key in map) pick(map[e.key]);
        });

        /* ═══════ الإقلاع ═══════ */
        renderWelcome();
    </script>
